+    splits: c_int = 1,
+    kblocks: c_int = 0,
+    z: u64 = 0,
+    y: u64 = 0,
+    ldy: i64 = 0,
+    y_dtype: c_int = 0,
+    accumulate: c_int = 0,
+};
+

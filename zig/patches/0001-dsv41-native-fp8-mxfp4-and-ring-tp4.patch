+    var buf: [512]u8 = undefined;
+    const path = std.mem.printSentinel(&buf, "{s}/{s}-0.bin", .{ dir, name }, 0) catch return;
+    const f = std.c.fopen(path.ptr, "wb") orelse return;
+    defer _ = std.c.fclose(f);
+    _ = std.c.fwrite(bytes.ptr, 1, bytes.len, f);

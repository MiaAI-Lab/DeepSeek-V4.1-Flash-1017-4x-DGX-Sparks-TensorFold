diff --git a/zig/src/core/uring_read.zig b/zig/src/core/uring_read.zig
new file mode 100644
index 00000000..d74f00c3
--- /dev/null
+++ b/zig/src/core/uring_read.zig
@@ -0,0 +1,144 @@
+//! Batches of positional reads through io_uring, as a drop-in for the kernel-AIO ring engram_aio.zig uses.
+//!
+//! Why it exists: libaio (`io_submit`) only queues if the file system implements async completion, and OpenZFS does
+//! not -- since Linux 4.1's read_iter conversion a file system without its own queued path completes the read inside
+//! the submitting thread, so a batch of rows one io_submit deep runs at queue depth 1 (measured: 2.4-3.9 s for 2048
+//! rows on rpool/dsv41-engram against 14 ms for the thread pool). io_uring is different: a request it cannot run in
+//! the caller's context is handed to the kernel's io-wq workers, so the same batch overlaps whatever the file system
+//! does -- forced with IOSQE_ASYNC, since a file system may ignore IOCB_NOWAIT instead of declining with -EAGAIN
+//! (see submit). Same syscalls on every architecture, no liburing.
+const std = @import("std");
+const linux = std.os.linux;
+
+/// One read: `buf` receives `buf.len` bytes at `off` of `fd`; `tag` comes back with its completion.
+pub const Op = struct { fd: linux.fd_t, buf: []u8, off: u64, tag: u64 };
+
+/// One completion: the op's tag and the result (bytes read, or a negative errno).
+pub const Cqe = struct { tag: u64, res: i32 };
+
+pub const Ring = struct {
+    ring: linux.IoUring,
+
+    /// `entries` must be a power of two (1 .. 32768). error.UringUnavailable when the kernel, the container's seccomp
+    /// policy or a resource limit refuses it -- the caller then keeps its previous path.
+    pub fn init(entries: u16) !Ring {
+        if (entries == 0) return error.EntriesZero;
+        const ring = linux.IoUring.init(entries, 0) catch |e| switch (e) {
+            error.SystemOutdated, error.PermissionDenied, error.ArgumentsInvalid => return error.UringUnavailable,
+            else => return e,
+        };
+        return .{ .ring = ring };
+    }
+
+    pub fn deinit(r: *Ring) void {
+        r.ring.deinit();
+    }
+
+    /// Queue `ops` and submit them. Returns how many were queued (a short count means the submission queue filled or
+    /// the kernel refused: the caller counts the rest as failed, as its AIO path does).
+    ///
+    /// Every request carries IOSQE_ASYNC, so it goes to an io-wq worker instead of being tried inline first. That flag
+    /// is the whole point here: io_uring only punts a read the file system declines with -EAGAIN, and a file system
+    /// that ignores IOCB_NOWAIT (which is what makes its io_submit path synchronous in the first place) would complete
+    /// the read in the submitting thread and leave a batch at queue depth 1 again -- with correct results, so no test
+    /// would notice. Forcing the worker hop is one context switch a read and buys the concurrency unconditionally.
+    pub fn submit(r: *Ring, ops: []const Op) usize {
+        var queued: usize = 0;
+        while (queued < ops.len) {
+            const op = ops[queued];
+            const sqe = r.ring.read(op.tag, op.fd, .{ .buffer = op.buf }, op.off) catch break;
+            sqe.flags |= linux.IOSQE_ASYNC;
+            queued += 1;
+        }
+        // hand over everything queued so far; sq_ready drops as submit drains it
+        while (r.ring.sq_ready() > 0) {
+            _ = r.ring.submit() catch break;
+        }
+        return queued;
+    }
+
+    /// Completions that are already there (never blocks). Returns the count written into `out`.
+    pub fn reap(r: *Ring, out: []Cqe) usize {
+        var cqes: [64]linux.io_uring_cqe = undefined;
+        var n: usize = 0;
+        while (n < out.len) {
+            const got = r.ring.copy_cqes(&cqes, 0) catch return n;
+            if (got == 0) return n;
+            for (cqes[0..got]) |c| {
+                if (n == out.len) return n; // caller reaps again on its next turn
+                out[n] = .{ .tag = c.user_data, .res = c.res };
+                n += 1;
+            }
+        }
+        return n;
+    }
+};
+
+test "io_uring reads a batch of spans, completions tagged and byte-exact" {
+    if (@import("builtin").os.tag != .linux) return error.SkipZigTest;
+    const a = std.testing.allocator;
+    const io = std.testing.io;
+
+    var r = Ring.init(16) catch |e| switch (e) {
+        error.UringUnavailable => return error.SkipZigTest,
+        else => return e,
+    };
+    defer r.deinit();
+
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    var data: [8192]u8 = undefined;
+    for (&data, 0..) |*b, i| b.* = @intCast((i * 31 + 7) % 251);
+    try tmp.dir.writeFile(io, .{ .sub_path = "rows.bin", .data = &data });
+    const file = try tmp.dir.openFile(io, "rows.bin", .{});
+    defer file.close(io);
+    const fd: linux.fd_t = file.handle;
+
+    // three spans of different lengths, deliberately out of order
+    var b0: [64]u8 = undefined;
+    var b1: [256]u8 = undefined;
+    var b2: [9]u8 = undefined;
+    const ops = [_]Op{
+        .{ .fd = fd, .buf = &b0, .off = 4096, .tag = 0xA },
+        .{ .fd = fd, .buf = &b1, .off = 0, .tag = 0xB },
+        .{ .fd = fd, .buf = &b2, .off = 8000, .tag = 0xC },
+    };
+    const queued = r.submit(&ops);
+    try std.testing.expectEqual(@as(usize, 3), queued);
+    // every queued request must carry IOSQE_ASYNC or the batch can run inline on a file system that ignores
+    // IOCB_NOWAIT, which is the whole case this module exists for
+    comptime {
+        const src = @embedFile("uring_read.zig");
+        if (std.mem.indexOf(u8, src, "sqe.flags |= linux.IOSQE_ASYNC;") == null)
+            @compileError("submit must set IOSQE_ASYNC");
+    }
+
+    var got: [8]Cqe = undefined;
+    var seen: usize = 0;
+    while (seen < 3) {
+        const n = r.reap(&got);
+        if (n == 0) {
+            io.sleep(.fromMilliseconds(1), .awake) catch {};
+            continue;
+        }
+        for (got[0..n]) |c| {
+            switch (c.tag) {
+                0xA => {
+                    try std.testing.expectEqual(@as(i32, 64), c.res);
+                    try std.testing.expectEqualSlices(u8, data[4096..][0..64], &b0);
+                },
+                0xB => {
+                    try std.testing.expectEqual(@as(i32, 256), c.res);
+                    try std.testing.expectEqualSlices(u8, data[0..256], &b1);
+                },
+                0xC => {
+                    try std.testing.expectEqual(@as(i32, 9), c.res);
+                    try std.testing.expectEqualSlices(u8, data[8000..][0..9], &b2);
+                },
+                else => return error.UnexpectedTag,
+            }
+            seen += 1;
+        }
+    }
+    _ = a;
+}

+test "auto mode: the probe agrees with what the ring then does" {
+    if (@import("builtin").os.tag != .linux) return error.SkipZigTest;
+    const a = std.testing.allocator;
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{ .iterate = true });
+    defer tmp.cleanup();
+    try tmp.dir.writeFile(io, .{ .sub_path = "plain.bin", .data = &@as([8192]u8, @splat(7)) });
+    const file = try tmp.dir.openFile(io, "plain.bin", .{});
+    defer file.close(io);
+    const fd: linux.fd_t = file.handle;
+
+    const ring = try Aio.initBackend(a, io, 8, .aio);
+    defer ring.deinit();
+    const queues = Aio.queuesAio(ring, fd);
+    // the probe must not leave a completion behind for a batch to trip over
+    if (!queues) {
+        var ev: [2]IoEvent = undefined;
+        var zero: linux.timespec = .{ .sec = 0, .nsec = 0 };
+        try std.testing.expectEqual(@as(isize, 0), ioGetevents(ring.ctx, 0, ev.len, &ev, &zero));
+    }
+    // an auto ring on this file system ends up on the backend the probe predicts, and both give the pool's bytes
+    const auto = try Aio.init(a, io, 8);
+    defer auto.deinit();
+    try std.testing.expect(auto.auto);
+    auto.autoUpgrade(fd);
+    try std.testing.expectEqual(if (queues) Backend.aio else Backend.uring, auto.backend);
+}

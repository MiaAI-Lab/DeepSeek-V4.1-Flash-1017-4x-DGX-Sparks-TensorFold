+        while (sent < reads) {
+            const r = ioSubmit(a.ctx, reads - sent, ptrs[sent..].ptr);
+            if (r <= 0) {
+                const bp = a.batches.getPtr(id).?;
+                bp.left -= reads - sent; // never submitted
+                bp.failed = true;
+                break;
+            }
+            sent += @intCast(r);
+        }
+        return id;
+    }

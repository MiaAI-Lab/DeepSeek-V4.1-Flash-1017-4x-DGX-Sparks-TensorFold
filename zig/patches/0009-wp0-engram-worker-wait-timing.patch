+        std.debug.print("[tf-timing] engram_worker_wait ci={d} j={d} wait_us={d} entry_was_after_worker_done_by_us={d}\n", .{ ci, j, wait_us, done_before_us });
+    }
     return eh.wk_rows[ci % 2][j];
 }
 

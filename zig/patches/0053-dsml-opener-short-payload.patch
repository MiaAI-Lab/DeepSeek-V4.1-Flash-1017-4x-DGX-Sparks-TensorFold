Subject: a tool-call block whose payload opens with a DSML opener but is too short to hold its closer stays text, instead of a slice past the payload's start

diff --git a/zig/src/server/tool_parse.zig b/zig/src/server/tool_parse.zig
index daec4e64..c4eed8ed 100644
--- a/zig/src/server/tool_parse.zig
+++ b/zig/src/server/tool_parse.zig
@@ -130,6 +130,15 @@ pub fn parse(a: Allocator, text: []const u8, tools: []const Value, max_calls: ?u
     return if (n_read > n_cut) read else cut;
 }
 
+/// The inside of ``body`` (an envelope's payload) when it opens with a DSML opener, read as it always was: the opener cut
+/// from its start and a closer's length from its end. A ``<tool_call>`` block's payload can open with a DSML opener and
+/// be too short to hold a closer as well (``<tool_call><｜DSML｜ calls></tool_call>``); cutting both from it would slice
+/// past its own start, so it reads as no DSML block. Every payload long enough reads as before.
+fn dsmlBlock(body: []const u8, open: []const u8, close: []const u8) ?[]const u8 {
+    if (body.len < open.len + close.len or !std.mem.startsWith(u8, body, open)) return null;
+    return body[open.len .. body.len - close.len];
+}

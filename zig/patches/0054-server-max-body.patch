-pub const limit = 32 * 1024 * 1024;
+/// The request-body ceiling in bytes: 32 MiB unless TF_DS_MAX_BODY_MIB (whole MiB) raises it, set once
+/// at startup by initLimit. A front proxy that forwards larger bodies -- images dominate a request's
+/// bytes -- needs the matching value here, or it admits what this then refuses.
+pub var limit: usize = 32 * 1024 * 1024;
+
+pub fn initLimit() void {
+    const v = std.c.getenv("TF_DS_MAX_BODY_MIB") orelse return;
+    const mib = std.fmt.parseInt(usize, std.mem.span(v), 10) catch return;
+    if (mib > 0) limit = mib * 1024 * 1024;
+}
 const metadata_limit = 65536;
 
